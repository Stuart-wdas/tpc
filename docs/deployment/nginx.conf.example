# Replace the domain and certificate paths after provisioning TLS.
server {
    listen 80;
    server_name tpc.example www.tpc.example;
    return 301 https://tpc.example$request_uri;
}
server {
    listen 443 ssl;
    server_name tpc.example;
    ssl_certificate /etc/letsencrypt/live/tpc.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tpc.example/privkey.pem;
    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
