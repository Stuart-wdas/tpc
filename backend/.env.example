PORT=4000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tpc
# Tests require separate disposable PostgreSQL databases.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tpc_test
# E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tpc_e2e
# SMOKE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tpc_smoke
# Production requires DATABASE_URL and a random auth secret of at least 32 characters.
# BETTER_AUTH_SECRET=
# Local seed: admin / 123. Production requires an initial password of at least 12 characters.
# SEED_ADMIN_PASSWORD=
# Used by docs/deployment/compose.yaml:
# POSTGRES_PASSWORD=
